<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.visionflow.core.auth.repo.UserReadMapper">

    <resultMap id="UserResponseMap" type="com.visionflow.core.auth.dto.response.UserResponse">
        <constructor>
            <idArg column="id"         javaType="Long"/>
            <arg  column="first_name"  javaType="String"/>
            <arg  column="last_name"   javaType="String"/>
            <arg  column="email"       javaType="String"/>
            <arg  column="phone"       javaType="String"/>
            <arg  column="role"        javaType="com.visionflow.core.auth.enums.Role"
                  typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
            <arg  column="active"      javaType="boolean"/>
            <arg  column="created_at"  javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <select id="findById" resultMap="UserResponseMap">
        SELECT id, first_name, last_name, email, phone, role, active, created_at
        FROM users
        WHERE id = #{id}
          AND deleted = false
    </select>

    <select id="findAll" resultMap="UserResponseMap">
        SELECT id, first_name, last_name, email, phone, role, active, created_at
        FROM users
        WHERE deleted = false
        <if test="role != null">
            AND role = #{role}
        </if>
        <if test="active != null">
            AND active = #{active}
        </if>
        ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM users
        WHERE deleted = false
        <if test="role != null">
            AND role = #{role}
        </if>
        <if test="active != null">
            AND active = #{active}
        </if>
    </select>

</mapper>
